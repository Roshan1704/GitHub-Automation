<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="StripeAutomationSuite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.stripe.automation.listeners.TestListener"/>
    </listeners>

    <test name="API and Webhook">
        <groups>
            <run>
                <include name="api"/>
                <include name="webhook"/>
            </run>
        </groups>
        <classes>
            <class name="com.stripe.automation.tests.StripeApiTests"/>
            <class name="com.stripe.automation.tests.WebhookValidationTests"/>
        </classes>
    </test>

    <test name="UI Cucumber">
        <classes>
            <class name="com.stripe.automation.runners.CucumberTestNgRunner"/>
        </classes>
    </test>
</suite>
